// Custeia — schema de persistência (7 entidades do domínio).
// users, supplies, recipes, recipe_supplies, sales, sale_items, expenses

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Unidades de medida suportadas em insumos e receitas.
enum MeasurementUnit {
  kg
  g
  L
  ml
  unidade
  pacote
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplies Supply[]
  recipes  Recipe[]
  sales    Sale[]
  expenses Expense[]

  @@map("users")
}

model Supply {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  name             String
  purchaseQuantity Decimal         @map("purchase_quantity") @db.Decimal(12, 4)
  purchaseUnit     MeasurementUnit @map("purchase_unit")
  purchasePrice    Decimal         @map("purchase_price") @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeSupplies RecipeSupply[]

  @@index([userId])
  @@map("supplies")
}

model Recipe {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  name          String
  description   String?
  yieldQuantity Decimal         @map("yield_quantity") @db.Decimal(12, 4)
  yieldUnit     MeasurementUnit @map("yield_unit")
  sellingPrice  Decimal?        @map("selling_price") @db.Decimal(12, 2)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplies  RecipeSupply[]
  saleItems SaleItem[]

  @@index([userId])
  @@map("recipes")
}

model RecipeSupply {
  id       String          @id @default(uuid())
  recipeId String          @map("recipe_id")
  supplyId String          @map("supply_id")
  quantity Decimal         @db.Decimal(12, 4)
  unit     MeasurementUnit

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([recipeId, supplyId])
  @@index([supplyId])
  @@map("recipe_supplies")
}

model Sale {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  totalPrice Decimal  @map("total_price") @db.Decimal(12, 2)
  soldAt     DateTime @map("sold_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@index([userId])
  @@index([soldAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  recipeId  String  @map("recipe_id")
  quantity  Decimal @db.Decimal(12, 4)
  /// Preço praticado no momento da venda (histórico imutável).
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([recipeId])
  @@map("sale_items")
}

model Expense {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expenseDate])
  @@map("expenses")
}
